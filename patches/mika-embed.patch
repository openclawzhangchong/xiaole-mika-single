diff --git a/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt b/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt
new file mode 100644
index 00000000..590b876c
--- /dev/null
+++ b/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt
@@ -0,0 +1,39 @@
+package com.wangzan101.mika.core.voice
+
+/**
+ * 同一进程内的麦克风租约。
+ *
+ * 并入小乐单包后,小乐的实时通话录音(MediaRecorder/AudioRecord)与 Mika 的按住说话([com.wangzan101.mika.voice.PcmRecorder])
+ * 跑在同一个进程、同一个 UID 下,系统不会再替它们做互斥,两路同时开流时有的机型会把其中一路静音。
+ * 所以这里用一把进程内的互斥锁:谁先拿到租约谁录,另一方直接放弃本次录音(而不是排队等待,避免按住说话"按下去没反应若干秒")。
+ *
+ * 放在 core(纯 JVM)里,可以被 Mika 和小乐两个模块共用,也能用普通的 JVM 单测覆盖。
+ */
+object MicGate {
+    /** 小乐实时通话的持有者标识。 */
+    const val XIAOLE = "xiaole"
+
+    /** Mika 按住说话/语音输入的持有者标识。 */
+    const val MIKA = "mika"
+
+    private var owner: String? = null
+
+    /** 同一持有者重复获取视为成功(重复 start 不会把自己锁死)。 */
+    @Synchronized
+    fun tryAcquire(who: String): Boolean {
+        val current = owner
+        if (current != null && current != who) return false
+        owner = who
+        return true
+    }
+
+    /** 只有持有者能释放,别的模块调 release 不会误放别人的租约。 */
+    @Synchronized
+    fun release(who: String) {
+        if (owner == who) owner = null
+    }
+
+    /** 当前持有者;没人持有返回 null。 */
+    @Synchronized
+    fun holder(): String? = owner
+}
