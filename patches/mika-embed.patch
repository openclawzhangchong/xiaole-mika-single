diff --git a/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt b/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt
new file mode 100644
index 00000000..b6714072
--- /dev/null
+++ b/core/src/main/kotlin/com/wangzan101/mika/core/voice/MicGate.kt
@@ -0,0 +1,56 @@
+package com.wangzan101.mika.core.voice
+
+/**
+ * 同一进程内的麦克风租约。
+ *
+ * 并入小乐单包后,小乐的实时通话录音(MediaRecorder/AudioRecord)与 Mika 的按住说话([com.wangzan101.mika.voice.PcmRecorder])
+ * 跑在同一个进程、同一个 UID 下,系统不会再替它们做互斥,两路同时开流时有的机型会把其中一路静音。
+ * 所以这里用一把进程内的互斥锁:谁先拿到租约谁录,另一方直接放弃本次录音(而不是排队等待,避免按住说话"按下去没反应若干秒")。
+ *
+ * 放在 core(纯 JVM)里,可以被 Mika 和小乐两个模块共用,也能用普通的 JVM 单测覆盖。
+ */
+object MicGate {
+    /** 小乐实时通话的持有者标识。 */
+    const val XIAOLE = "xiaole"
+
+    /** Mika 按住说话/语音输入的持有者标识。 */
+    const val MIKA = "mika"
+
+    private var owner: String? = null
+
+    /**
+     * 运行层可直读日志的出口。
+     *
+     * core 是纯 JVM 模块,不能直接引 android.util.Log;由宿主在启动时注入(见 MikaApp)。
+     * 单测不注入即为空实现,不影响 JVM 跑测。日志点都是普通调用,release + R8 不会 strip。
+     */
+    var logger: ((String) -> Unit)? = null
+
+    private fun log(message: String) {
+        logger?.invoke(message)
+    }
+
+    /** 同一持有者重复获取视为成功(重复 start 不会把自己锁死)。 */
+    @Synchronized
+    fun tryAcquire(who: String): Boolean {
+        val current = owner
+        if (current != null && current != who) {
+            log("acquire holder=$who 被拒 当前持有者=$current 原因=已被其它租约持有")
+            return false
+        }
+        owner = who
+        log("acquire holder=$who 成功 持有者=$who")
+        return true
+    }
+
+    /** 只有持有者能释放,别的模块调 release 不会误放别人的租约。 */
+    @Synchronized
+    fun release(who: String) {
+        if (owner == who) owner = null
+        log("release holder=$who 归还 剩余=${owner ?: "无"}")
+    }
+
+    /** 当前持有者;没人持有返回 null。 */
+    @Synchronized
+    fun holder(): String? = owner
+}
diff --git a/core/src/test/kotlin/com/wangzan101/mika/core/voice/MicGateTest.kt b/core/src/test/kotlin/com/wangzan101/mika/core/voice/MicGateTest.kt
new file mode 100644
index 00000000..14d4d55e
--- /dev/null
+++ b/core/src/test/kotlin/com/wangzan101/mika/core/voice/MicGateTest.kt
@@ -0,0 +1,43 @@
+package com.wangzan101.mika.core.voice
+
+import org.junit.After
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** 单包内小乐通话与 Mika 录音共用一支麦克风,租约必须互斥、可重入、只能本人释放。 */
+class MicGateTest {
+    @After
+    fun cleanup() {
+        MicGate.release(MicGate.XIAOLE)
+        MicGate.release(MicGate.MIKA)
+    }
+
+    @Test
+    fun holderCanRecordAndOtherIsRefused() {
+        assertTrue(MicGate.tryAcquire(MicGate.XIAOLE))
+        assertEquals(MicGate.XIAOLE, MicGate.holder())
+        assertFalse(MicGate.tryAcquire(MicGate.MIKA))
+        assertEquals(MicGate.XIAOLE, MicGate.holder())
+    }
+
+    @Test
+    fun sameOwnerCanReacquire() {
+        assertTrue(MicGate.tryAcquire(MicGate.XIAOLE))
+        assertTrue(MicGate.tryAcquire(MicGate.XIAOLE))
+        assertEquals(MicGate.XIAOLE, MicGate.holder())
+    }
+
+    @Test
+    fun onlyHolderCanReleaseThenNextOwnerSucceeds() {
+        assertTrue(MicGate.tryAcquire(MicGate.XIAOLE))
+        MicGate.release(MicGate.MIKA)
+        assertEquals(MicGate.XIAOLE, MicGate.holder())
+        MicGate.release(MicGate.XIAOLE)
+        assertNull(MicGate.holder())
+        assertTrue(MicGate.tryAcquire(MicGate.MIKA))
+        assertEquals(MicGate.MIKA, MicGate.holder())
+    }
+}
